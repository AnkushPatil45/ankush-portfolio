---
// Self-hosted fonts (no render-blocking Google Fonts request).
// Fraunces is only used italic, so we ship just the italic variant.
import '@fontsource/fraunces/500-italic.css';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { profile } from '../data/site';

const title = 'Ankush Patil - Cloud Engineer & AWS Solutions Architect | Canada & India';
const description =
  'AWS-certified Cloud Engineer & Solutions Architect. Gold & silver at Skills Ontario and Skills Canada Nationals 2026. Open to Cloud, Security & DevOps roles across Canada and India, on-site or remote.';
const keywords =
  'Ankush Patil, Cloud Engineer, AWS Solutions Architect, Cloud Security Engineer, DevOps Engineer, Cloud Engineer Canada, Cloud Engineer India, AWS Solutions Architect India, AWS certified, Terraform, Kubernetes, Azure, Cloud Architecture, Skills Ontario, Skills Canada Nationals, cloud computing, hire cloud engineer, remote cloud engineer';
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // "/ankush-portfolio"
const canonical = new URL(base + '/', Astro.site).href;
const ogImage = new URL(base + '/og-card-v2.jpg', Astro.site).href;

// Google Search Console verification token.
const gscVerification = 'peL8YaqN0GFASW19ekDhiLIwynDsbkDxyRIfI8OmZFA';

// Google Analytics 4 measurement ID.
const gaId = 'G-YXW401W2XD';

const person = {
  '@type': 'Person',
  '@id': canonical + '#person',
  name: profile.name,
  jobTitle: 'Cloud Engineer',
  description:
    'AWS-certified Cloud Engineer specializing in cloud architecture, security operations, and infrastructure-as-code, open to roles across Canada and India.',
  email: `mailto:${profile.email}`,
  url: canonical,
  image: ogImage,
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: [
    'Cloud Architecture',
    'Amazon Web Services',
    'AWS Solutions Architecture',
    'Cybersecurity',
    'Cloud Security',
    'Terraform',
    'Kubernetes',
    'Amazon EKS',
    'Microsoft Azure',
    'CI/CD',
    'CrowdStrike Falcon',
    'CyberArk Application Control',
    'Splunk',
    'Python',
  ],
  hasOccupation: {
    '@type': 'Occupation',
    name: 'Cloud Engineer',
    occupationLocation: [
      { '@type': 'Country', name: 'Canada' },
      { '@type': 'Country', name: 'India' },
    ],
    skills: 'AWS, Terraform, Kubernetes, Azure, cloud security, CI/CD, Python',
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Seneca Polytechnic' },
    { '@type': 'CollegeOrUniversity', name: 'Georgian College' },
  ],
  hasCredential: [
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'AWS Certified Solutions Architect - Associate' },
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'AWS Certified AI Practitioner' },
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'AWS Certified Cloud Practitioner' },
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'Google Cybersecurity Professional Certificate' },
  ],
  award: ['Gold - Skills Ontario 2026 (Cloud Computing)', 'Silver - Skills Canada Nationals 2026 (Cloud Computing)'],
  seeks: {
    '@type': 'Demand',
    name: 'Cloud Engineer, Cloud Security Engineer, Solutions Architect, or DevOps / Platform roles',
  },
};

const personLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': canonical + '#website',
      url: canonical,
      name: 'Ankush Patil, Cloud Engineer',
      inLanguage: 'en-CA',
      publisher: { '@id': canonical + '#person' },
    },
    {
      '@type': 'ProfilePage',
      '@id': canonical + '#webpage',
      url: canonical,
      name: title,
      isPartOf: { '@id': canonical + '#website' },
      about: { '@id': canonical + '#person' },
      mainEntity: { '@id': canonical + '#person' },
      primaryImageOfPage: ogImage,
      inLanguage: 'en-CA',
    },
    person,
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Google Analytics 4 (gtag.js) -->
    <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={base + '/favicon.svg'} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={base + '/apple-touch-icon.png'} />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    <meta name="theme-color" content="#0a0908" />
    <meta name="author" content={profile.name} />
    <meta name="geo.placename" content="Canada; India" />


    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Ankush Patil - Cloud Engineer" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:locale:alternate" content="en_IN" />
    <meta property="og:site_name" content="Ankush Patil - Cloud Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Ankush Patil - Cloud Engineer" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
