---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base>
  <div class="nf">
    <div class="nf-logo">patil<b>OS</b><i></i></div>
    <h1>404</h1>
    <p>That page doesn’t exist on this system.</p>
    <a href={base}>↩ Back to the desktop</a>
  </div>
</Base>

<style>
  .nf {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    text-align: center;
    padding: 0 24px;
    background: var(--bg2);
  }
  .nf-logo {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--text);
    display: flex;
    align-items: center;
    margin-bottom: 8px;
  }
  .nf-logo b { color: var(--gold); }
  .nf-logo i {
    display: inline-block;
    width: 8px;
    height: 18px;
    margin-left: 5px;
    border-radius: 2px;
    background: var(--gold);
    box-shadow: 0 0 12px rgba(240, 182, 75, 0.7);
    animation: caretBlink 1.1s steps(1) infinite;
  }
  .nf h1 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: 96px;
    line-height: 1;
    color: var(--text);
  }
  .nf p { color: var(--dim); font-size: 15px; }
  .nf a {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--gold);
    text-decoration: none;
    border: 1px solid rgba(240, 182, 75, 0.4);
    border-radius: 8px;
    padding: 10px 18px;
    transition: background 0.2s;
  }
  .nf a:hover { background: rgba(240, 182, 75, 0.08); }
</style>
