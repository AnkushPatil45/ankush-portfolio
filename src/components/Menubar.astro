---
import { profile } from '../data/site';
const resumeUrl = import.meta.env.BASE_URL + 'Ankush_Patil_CV.pdf';
const nav = [
  ['win-about', 'About'],
  ['win-medals', 'Medals'],
  ['win-projects', 'Projects'],
  ['win-creds', 'Credentials'],
  ['win-xp', 'Experience'],
  ['win-contact', 'Contact'],
  ['win-terminal', 'Terminal'],
];
---
<div id="menubar">
  <span class="os" title="PatilOS"><span class="wm">patil<b>OS</b></span><i class="caret"></i></span>
  {nav.map(([id, label]) => <span class="item" data-open={id}>{label}</span>)}
  <div class="right">
    <nav class="ql" aria-label="Quick links">
      <a class="ql-a primary" href={resumeUrl} download="Ankush_Patil_CV.pdf" title="Download résumé (PDF)"><svg class="ic" aria-hidden="true"><use href="#i-file"></use></svg><span>Résumé</span></a>
      <a class="ql-a" href={profile.linkedin} target="_blank" rel="noopener" title="LinkedIn profile"><svg class="ic ic-brand" aria-hidden="true"><use href="#i-linkedin"></use></svg><span>LinkedIn</span></a>
      <a class="ql-a" href={profile.github} target="_blank" rel="noopener" title="GitHub profile"><svg class="ic ic-brand" aria-hidden="true"><use href="#i-github"></use></svg><span>GitHub</span></a>
      <a class="ql-a" href={`mailto:${profile.email}`} title="Email Ankush"><svg class="ic" aria-hidden="true"><use href="#i-mail"></use></svg><span>Email</span></a>
    </nav>
    <span class="sep">·</span>
    <span class="status" title="Open to Cloud Engineer roles"><i class="sdot"></i> Available for work</span>
    <span class="sep">·</span>
    <span class="loc">Toronto, ON</span>
    <span id="snd" class="mb-btn" title="Toggle sound"><svg class="ic ic-sm"><use href="#i-vol"></use></svg></span>
    <span id="clock" title="Local time">--:--</span>
  </div>
</div>
