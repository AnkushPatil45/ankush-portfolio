---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { awsCerts, otherCerts, awsBadges, trainingBadges } from '../../data/site';

const badgeMods = import.meta.glob<{ default: ImageMetadata }>('../../assets/badges/*.jpeg', { eager: true });
const badges: Record<string, ImageMetadata> = {};
for (const path in badgeMods) {
  const name = path.split('/').pop()!.replace('.jpeg', '');
  badges[name] = badgeMods[path].default;
}
const alt: Record<string, string> = {
  'solutions-architect': 'AWS Certified Solutions Architect Associate badge',
  'ai-practitioner': 'AWS Certified AI Practitioner badge',
  'cloud-practitioner': 'AWS Certified Cloud Practitioner badge',
  'cloud-architecting': 'AWS Academy Cloud Architecting badge',
  'cloud-security-builder': 'AWS Academy Cloud Security Builder badge',
  'cloud-security-foundations': 'AWS Academy Cloud Security Foundations badge',
  'generative-ai-foundations': 'AWS Academy Generative AI Foundations badge',
  'cloud-developing': 'AWS Academy Cloud Developing badge',
  'cloud-foundations': 'AWS Academy Cloud Foundations badge',
};
const label: Record<string, string> = {
  'solutions-architect': 'Solutions Architect',
  'ai-practitioner': 'AI Practitioner',
  'cloud-practitioner': 'Cloud Practitioner',
  'cloud-architecting': 'Cloud Architecting',
  'cloud-security-builder': 'Security Builder',
  'cloud-security-foundations': 'Security Foundations',
  'generative-ai-foundations': 'GenAI Foundations',
  'cloud-developing': 'Cloud Developing',
  'cloud-foundations': 'Cloud Foundations',
};
---
<div class="sec-head"><span class="sec-no">A1</span><h3>AWS - Certified</h3></div>
<ul class="check-list">
  {awsCerts.map((c) => (
    <li><svg class="ic ck"><use href="#i-badge"></use></svg>{c.name}<span class="yr">{c.year}</span></li>
  ))}
</ul>
<div class="badge-grid">
  {awsBadges.map((b) => (
    <div class="badge">
      <Image src={badges[b]} alt={alt[b]} width={144} height={144} loading="lazy" />
      <span class="blabel">{label[b]}</span>
    </div>
  ))}
</div>

<div class="sec-head"><span class="sec-no">A2</span><h3>AWS Academy - Trainings</h3></div>
<div class="badge-grid">
  {trainingBadges.map((b) => (
    <div class="badge">
      <Image src={badges[b]} alt={alt[b]} width={144} height={144} loading="lazy" />
      <span class="blabel">{label[b]}</span>
    </div>
  ))}
</div>

<div class="sec-head"><span class="sec-no">A3</span><h3>Cybersecurity</h3></div>
<ul class="check-list">
  {otherCerts.map((c) => (
    <li><svg class="ic ck"><use href="#i-badge"></use></svg>{c.name}<span class="yr">{c.year}</span></li>
  ))}
</ul>
<p class="sub" style="margin-top:18px">↳ Schools &amp; GPA live in <b style="color:var(--accent)">about.md</b></p>
