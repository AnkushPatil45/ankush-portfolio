---
import { Image } from 'astro:assets';
import ontario from '../../assets/photos/ontario-march.jpeg';
import { profile, education } from '../../data/site';
---
<h2>{profile.name}</h2>
<p class="sub">{profile.role}</p>
<div class="win-photo">
  <Image src={ontario} alt="Ankush Patil at the Skills Ontario provincial championships, 2026" widths={[520, 1040]} sizes="(max-width:760px) 92vw, 520px" loading="lazy" />
</div>
<p style="margin-top:14px">{profile.summary}</p>
<p>{profile.ethos}</p>

<div class="stat-grid">
  <div class="stat"><div class="num">4.0</div><div class="lbl">GPA · ×2 programs</div></div>
  <div class="stat"><div class="num">3+</div><div class="lbl">AWS certs · 2026</div></div>
  <div class="stat"><div class="num">2</div><div class="lbl">Skills medals · 2026</div></div>
</div>

<div class="sec-head"><span class="sec-no">01</span><h3>Education</h3></div>
{education.map((e) => (
  <div class="tl-item">
    <div class="row"><b>{e.title}</b><span class="yr">{e.year}</span></div>
    <div class="tl-bar"><i style={`--w:${e.w}%`}></i></div>
  </div>
))}

<div class="sec-head"><span class="sec-no">02</span><h3>Disciplines</h3></div>
<div class="tagrow">{profile.disciplines.map((d) => <span>{d}</span>)}</div>
