---
import { profile, experience, education, awsCerts, otherCerts, medals, skills } from '../../data/site';
---
<div class="resume-bar">
  <span class="ttl">Résumé · Ankush Patil</span>
  <span class="ttl" style="color:var(--gold)">Cloud Engineer</span>
</div>
<div class="resume-doc" id="resume-doc">
  <div class="r-name">{profile.name}</div>
  <div class="r-tag">CLOUD ENGINEER</div>
  <div class="r-contact">
    <a href={`mailto:${profile.email}`}>{profile.email}</a>
    <a href={profile.github} target="_blank" rel="noopener">{profile.githubHandle}</a>
    <a href={profile.linkedin} target="_blank" rel="noopener">{profile.linkedinHandle}</a>
    <span>Toronto, ON · authorized to work in Canada</span>
  </div>

  <div class="r-sec">
    <h4>Summary</h4>
    <p style="margin:0">Cloud Engineer designing and securing AWS-first infrastructure, with Azure for hybrid. Enterprise security-operations experience, a software-engineering background, and a 2026 competition season ending in gold at Skills Ontario and silver at the Skills Canada Nationals in cloud computing. 4.0 GPA across two postgraduate programs.</p>
  </div>

  <div class="r-sec">
    <h4>Experience</h4>
    {experience.map((job) => (
      <div class="r-job">
        <div class="row"><b>{job.title}</b><span class="yr">{job.year}</span></div>
        <div class="r-meta">{job.meta}</div>
        <ul class="list">{job.bullets.map((b) => <li>{b}</li>)}</ul>
      </div>
    ))}
  </div>

  <div class="r-sec">
    <h4>Education</h4>
    <ul class="list">
      {education.map((e) => (
        <li class="row">{e.title}{e.w > 40 ? ' · GPA 4.0' : ''}<span class="yr">{e.year}</span></li>
      ))}
    </ul>
  </div>

  <div class="r-sec">
    <h4>Certifications &amp; Awards (2026)</h4>
    <ul class="list">
      <li class="row">AWS - {awsCerts.map((c) => c.name).join(' · ')}<span class="yr">2026</span></li>
      {otherCerts.map((c) => <li class="row">{c.name}<span class="yr">{c.year}</span></li>)}
      <li class="row">🥇 Gold - Skills Ontario · 🥈 Silver - Skills Canada Nationals, cloud computing<span class="yr">2026</span></li>
    </ul>
  </div>

  <div class="r-sec">
    <h4>Core Skills</h4>
    <div class="tagrow">
      <span>AWS</span><span>Terraform</span><span>ECS / EKS</span><span>Azure</span><span>CrowdStrike Falcon</span><span>Splunk</span><span>Python</span><span>CI/CD</span><span>Least Privilege</span>
    </div>
  </div>
</div>
